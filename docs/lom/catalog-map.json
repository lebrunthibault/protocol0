{
  "_comment": "Hand-maintained join table between the LOM inventory (lom-inventory.json, generated) and the @action catalog. Keys are inventory op ids (<ClassKey>.<member>). status: exposed (an @action covers it) | domain-only (wrapped in the domain layer, not exposed yet) | skipped (deliberately not exposed, give a reason). Run scripts/lom_catalog/coverage.py after editing.",
  "ops": {
    "Song.View.selected_track": {
      "status": "exposed",
      "action": "track/select",
      "domain": "SimpleTrack.select"
    },
    "Browser.load_item": {
      "status": "exposed",
      "action": "device/load_device",
      "domain": "DeviceService.load_device"
    },
    "Clip.get_notes_extended": {
      "status": "exposed",
      "action": "clip/remove_muted_notes",
      "domain": "MidiClip.get_notes"
    },
    "Clip.remove_notes_extended": {
      "status": "exposed",
      "action": "clip/remove_muted_notes",
      "domain": "MidiClip.replace_notes"
    },
    "Clip.fire": {
      "status": "exposed",
      "action": "track/fire",
      "domain": "SimpleTrack.fire"
    },
    "Song.start_playing": {
      "status": "exposed",
      "action": "transport/start_playback",
      "domain": "PlaybackComponent.start_playing"
    },
    "Song.stop_playing": {
      "status": "exposed",
      "action": "transport/stop_playback",
      "domain": "PlaybackComponent.stop"
    },
    "Song.stop_all_clips": {
      "status": "exposed",
